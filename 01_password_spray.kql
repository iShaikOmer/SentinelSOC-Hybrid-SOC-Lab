// AUTH-001 | Microsoft Entra ID password-spray pattern | MITRE ATT&CK T1110.003
// Prerequisite: Entra sign-in logs connected to the Sentinel Log Analytics workspace.
// Tune IP allowlists, failure reasons, time grain and thresholds for your environment.
SigninLogs
| where TimeGenerated > ago(1d)
| where tostring(ResultType) != "0"
| summarize FailedLogins=count(), DistinctUsers=dcount(UserPrincipalName),
            Accounts=make_set(UserPrincipalName, 25), FirstSeen=min(TimeGenerated),
            LastSeen=max(TimeGenerated)
    by IPAddress, WindowStart=bin(TimeGenerated, 30m)
| where FailedLogins >= 10 and DistinctUsers >= 5
| project WindowStart, IPAddress, FailedLogins, DistinctUsers, Accounts, FirstSeen, LastSeen
